#
# DO NOT EDIT: Generated by Ansible script.
#
# NOTE: for Docker to honor these limits the following snippet must be present
# in /etc/docker/daemon.json:
#
#    "cgroup-parent": "docker_limit.slice"
#
# The slice's presence in the system can be verified with:
#    sudo systemctl cat docker_limit.slice

[Unit]
Description=Slice that limits docker resources
[Slice]
# Only allow 8 cpus to be used. See systemd.resource-control(5).
CPUAccounting=true
CPUQuota=800%
MemoryAccounting=true
MemoryHigh=20G
MemoryMax=22G
